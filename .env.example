# SEKA runtime
SEKA_HOST=127.0.0.1
SEKA_PORT=8765
SEKA_DATA_DIR=./data
SEKA_DB_PATH=./data/seka.db
SEKA_UPLOAD_DIR=./data/uploads

# Admin bootstrap account.
# Change this before any public or shared deployment.
SEKA_ADMIN_USERNAME=admin
SEKA_ADMIN_PASSWORD=change-me-please

# Knowledge parsing / chunking
SEKA_MAX_UPLOAD_BYTES=52428800
SEKA_CHUNK_SIZE=900
SEKA_CHUNK_OVERLAP=140
SEKA_OCR_LANG=eng

# Optional OpenAI-compatible LLM.
# Leave empty to use local extractive answers.
OPENAI_API_KEY=
SEKA_LLM_API_KEY=
SEKA_LLM_BASE_URL=https://api.openai.com/v1
SEKA_LLM_MODEL=gpt-4o-mini
